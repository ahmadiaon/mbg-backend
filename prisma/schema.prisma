generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// AUTH — konkret (nrp + NIK saat pertama, nrp + PIN setelahnya)
// =====================================================================
model User {
  id        Int      @id @default(autoincrement())
  nrp       String   @unique
  name      String
  email     String?  @unique
  password  String? // hash NIK (login pertama)
  pin       String? // hash PIN (null = belum set PIN)
  role      Int      @default(1) // 1..5
  authLogin String? // token lama (kompatibilitas)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employmentStatuses EmploymentStatus[]
  featureOverrides   UserFeatureAccess[]
  auditLogs          HistoricalAuditLog[]
  approvalActions    ApprovalAction[]

  @@index([role])
}

// =====================================================================
// EAV CORE — SEMUA master & data dinamis (karyawan, perusahaan, jabatan,
// agama, unit, kode batu, dll) — field bisa bertambah tanpa ubah skema.
// =====================================================================

// "Tabel" dinamis (dulu database_tables)
model Entity {
  id          Int      @id @default(autoincrement())
  code        String   @unique // e.g. KARYAWAN, PERUSAHAAN, AGAMA, KODE-ABSEN
  name        String // description_table
  menu        String? // menu_table (pengelompokan menu)
  parentId    Int? // parent_table (tabel anak -> parent)
  primaryCode String? // primary_table (field code yg jadi PK)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Entity?  @relation("EntityTree", fields: [parentId], references: [id])
  children Entity[] @relation("EntityTree")
  fields   Field[]
  values   Value[]

  @@index([parentId])
}

// Kolom dinamis (dulu database_fields)
model Field {
  id         Int      @id @default(autoincrement())
  entityId   Int
  code       String // code_field (e.g. NRP, NAMA-KARYAWAN)
  name       String // description_field
  fullCode   String // full_code_field = entity.code + '-' + code
  type       String   @default("TEXT") // TEXT/DATE/COLOR/DARI-TABEL/INPUT-AUTOCOMPLITE/GABUNGAN/HIDDEN
  level      Int      @default(1) // level_data_field (role 1..5)
  sort       Int      @default(0) // sort_field
  visibility String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entity     Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  values     Value[]
  dataSource DataSource?

  @@unique([entityId, code])
}

// Nilai data (dulu database_data) — EAV murni
model Value {
  id         Int       @id @default(autoincrement())
  entityId   Int
  fieldId    Int
  recordCode String // code_data = PK record (NRP / ISLAM / DT-220 ...)
  recordUuid String? // uuid_data
  value      String? // value_data
  dateStart  DateTime?
  dateEnd    DateTime? // soft-delete / histori
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  field  Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([entityId, recordCode])
  @@index([fieldId])
}

// Lookup antar tabel (dulu database_data_sources) — untuk DARI-TABEL / AUTOCOMPLITE
model DataSource {
  id           Int     @id @default(autoincrement())
  fieldId      Int     @unique
  entitySource String? // table_data_source (entity sumber)
  fieldSource  String? // field_get_data_source (field yg diambil)

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

// Gabungan field (dulu database_field_shows) — untuk tipe GABUNGAN
model FieldShow {
  id            Int     @id @default(autoincrement())
  entityCode    String
  fieldCode     String
  fieldShowCode String
  splitBy       String? // pemisah (spasi, "-", dll)
  sort          Int     @default(0)
}

// Template tampilan per-user (dulu user_templates)
model UserTemplate {
  id           Int      @id @default(autoincrement())
  employeeUuid String
  entityGet    String?
  entityCode   String?
  fieldCode    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeUuid])
}

// Menu / group form (dulu group_forms)
model GroupForm {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================================================
// TRANSAKSIONAL — konkret (harian/bulanan, butuh performa & indeks)
// =====================================================================

// Absensi (dulu employee_absens / DATABASE-ABSENSI)
model Attendance {
  id          Int       @id @default(autoincrement())
  employeeNrp String // referensi ke recordCode KARYAWAN di EAV
  date        DateTime  @db.Date
  shiftCode   String?
  code        String? // KODE-ABSEN (A, TC, DS, NS, SP, ...)
  checkIn     DateTime?
  checkOut    DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeNrp, date])
  @@index([date])
  @@index([employeeNrp])
}

// Slip gaji (dulu slips)
model Payslip {
  id          Int      @id @default(autoincrement())
  employeeNrp String
  year        Int
  month       Int
  codeFile    String   @unique // NRP-tahun-bulan
  fileUrl     String? // URL PDF di server assets
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeNrp, year, month])
  @@index([year, month])
}

// =====================================================================
// AUTHORITY — role level, status kerja, struktur organisasi, dan feature
// =====================================================================

model RoleLevel {
  id          Int      @id @default(autoincrement())
  level       Int      @unique // 1..15
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employmentStatuses EmploymentStatus[]
  featurePolicies    FeatureAccessPolicy[]
  positions          Position[]
}

model OrganizationUnit {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  type      String // GROUP, COMPANY, PROJECT, DEPARTMENT, DIVISION
  parentId  Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent      OrganizationUnit?  @relation("OrganizationTree", fields: [parentId], references: [id])
  children    OrganizationUnit[] @relation("OrganizationTree")
  companies   EmploymentStatus[] @relation("EmploymentCompany")
  projects    EmploymentStatus[] @relation("EmploymentProject")
  departments EmploymentStatus[] @relation("EmploymentDepartment")
  divisions   EmploymentStatus[] @relation("EmploymentDivision")

  @@index([parentId])
  @@index([type, active])
}

model Position {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  roleLevelId Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleLevel          RoleLevel?         @relation(fields: [roleLevelId], references: [id], onDelete: SetNull)
  employmentStatuses EmploymentStatus[]

  @@index([roleLevelId])
}

model EmploymentStatus {
  id           Int       @id @default(autoincrement())
  userId       Int
  employeeNrp  String
  statusCode   String // ACTIVE, INACTIVE, TRANSFERRED, TERMINATED, SUSPENDED
  roleLevelId  Int
  positionId   Int?
  companyId    Int?
  projectId    Int?
  departmentId Int?
  divisionId   Int?
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLevel  RoleLevel         @relation(fields: [roleLevelId], references: [id])
  position   Position?         @relation(fields: [positionId], references: [id], onDelete: SetNull)
  company    OrganizationUnit? @relation("EmploymentCompany", fields: [companyId], references: [id], onDelete: SetNull)
  project    OrganizationUnit? @relation("EmploymentProject", fields: [projectId], references: [id], onDelete: SetNull)
  department OrganizationUnit? @relation("EmploymentDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  division   OrganizationUnit? @relation("EmploymentDivision", fields: [divisionId], references: [id], onDelete: SetNull)

  @@index([userId, statusCode])
  @@index([employeeNrp, statusCode])
  @@index([roleLevelId, statusCode])
  @@index([companyId, projectId, departmentId, divisionId])
  @@index([startDate, endDate])
}

model FeatureDefinition {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  route       String?
  icon        String?
  menuGroup   String?
  sort        Int      @default(0)
  active      Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  policies  FeatureAccessPolicy[]
  overrides UserFeatureAccess[]

  @@index([active, sort])
}

model FeatureAccessPolicy {
  id                   Int      @id @default(autoincrement())
  featureId            Int
  roleLevelId          Int
  employmentStatusCode String   @default("ACTIVE")
  canRead              Boolean  @default(false)
  canWrite             Boolean  @default(false)
  canEdit              Boolean  @default(false)
  canDelete            Boolean  @default(false)
  canImport            Boolean  @default(false)
  canExport            Boolean  @default(false)
  canSubmit            Boolean  @default(false)
  canApprove           Boolean  @default(false)
  canReject            Boolean  @default(false)
  canViewHistory       Boolean  @default(false)
  canRestore           Boolean  @default(false)
  scopeType            String   @default("SELF")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  feature   FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)
  roleLevel RoleLevel         @relation(fields: [roleLevelId], references: [id], onDelete: Cascade)

  @@unique([featureId, roleLevelId, employmentStatusCode])
  @@index([roleLevelId, employmentStatusCode, active])
}

model UserFeatureAccess {
  id                   Int       @id @default(autoincrement())
  userId               Int
  featureId            Int
  employmentStatusCode String?
  effect               String    @default("ALLOW") // ALLOW / DENY
  canRead              Boolean?
  canWrite             Boolean?
  canEdit              Boolean?
  canDelete            Boolean?
  canApprove           Boolean?
  canViewHistory       Boolean?
  scopeType            String?
  reason               String
  expiresAt            DateTime?
  createdBy            Int?
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([userId, active, expiresAt])
  @@index([featureId, employmentStatusCode])
}

// =====================================================================
// HISTORICAL DATA + APPROVAL — generik untuk data yang membutuhkan histori
// =====================================================================

model HistoricalDefinition {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  name             String
  entityCode       String?
  historyEnabled   Boolean  @default(true)
  approvalRequired Boolean  @default(true)
  workflowId       Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workflow ApprovalWorkflow?  @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  records  HistoricalRecord[]

  @@index([active])
}

model HistoricalRecord {
  id               Int      @id @default(autoincrement())
  definitionId     Int
  recordCode       String
  currentVersionId Int?
  status           String   @default("DRAFT")
  createdBy        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  definition HistoricalDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  versions   HistoricalVersion[]
  auditLogs  HistoricalAuditLog[]
  approvals  ApprovalInstance[]

  @@unique([definitionId, recordCode])
  @@index([status, definitionId])
}

model HistoricalVersion {
  id            Int      @id @default(autoincrement())
  recordId      Int
  versionNumber Int
  snapshotJson  Json
  changeReason  String?
  createdBy     Int
  createdAt     DateTime @default(now())

  record HistoricalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, versionNumber])
  @@index([recordId, createdAt])
}

model HistoricalAuditLog {
  id          Int      @id @default(autoincrement())
  recordId    Int
  versionId   Int?
  action      String
  fieldCode   String?
  oldValue    Json?
  newValue    Json?
  reason      String?
  performedBy Int
  createdAt   DateTime @default(now())

  record    HistoricalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  performer User             @relation(fields: [performedBy], references: [id])

  @@index([recordId, createdAt])
  @@index([performedBy, createdAt])
}

model ApprovalWorkflow {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  version   Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definitions HistoricalDefinition[]
  steps       ApprovalWorkflowStep[]
  instances   ApprovalInstance[]
}

model ApprovalWorkflowStep {
  id                 Int     @id @default(autoincrement())
  workflowId         Int
  stepNumber         Int
  name               String
  requiredRoleMin    Int?
  requiredRoleMax    Int?
  requiredPermission String?
  scopeType          String  @default("SELF")
  approverType       String  @default("ROLE_LEVEL")
  excludeAdmin       Boolean @default(true)
  excludeRequester   Boolean @default(true)
  active             Boolean @default(true)

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepNumber])
}

model ApprovalInstance {
  id                 Int       @id @default(autoincrement())
  historicalRecordId Int
  workflowId         Int
  currentStep        Int       @default(1)
  status             String    @default("PENDING")
  submittedBy        Int
  submittedAt        DateTime  @default(now())
  completedAt        DateTime?

  record   HistoricalRecord @relation(fields: [historicalRecordId], references: [id], onDelete: Cascade)
  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  actions  ApprovalAction[]

  @@index([historicalRecordId, status])
  @@index([workflowId, currentStep, status])
}

model ApprovalAction {
  id                 Int      @id @default(autoincrement())
  approvalInstanceId Int
  stepNumber         Int
  approverUserId     Int
  action             String // APPROVED / REJECTED / CANCELLED
  note               String?
  createdAt          DateTime @default(now())

  instance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  approver User             @relation(fields: [approverUserId], references: [id])

  @@index([approvalInstanceId, stepNumber])
  @@index([approverUserId, createdAt])
}
